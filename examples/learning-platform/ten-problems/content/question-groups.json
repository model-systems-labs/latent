  "objectives": [
    {
      "id": "scan-and-index",
      "title": "Scan and index sequences",
      "description": "Use sets, dictionaries, and moving windows to solve sequence problems without unnecessary nested scans."
    },
    {
      "id": "organize-state",
      "title": "Organize state with core structures",
      "description": "Choose stacks, sorted intervals, and linked structures that make the required invariant explicit."
    },
    {
      "id": "traverse-frontiers",
      "title": "Traverse grid and graph frontiers",
      "description": "Use breadth-first traversal to measure minimum time, distance, and reachability."
    },
    {
      "id": "optimize-recurrences",
      "title": "Optimize a recurrence",
      "description": "Turn repeated subproblems into a compact dynamic program with a clear state transition."
    },
    {
      "id": "search-the-answer",
      "title": "Search a monotonic answer space",
      "description": "Combine a greedy feasibility check with binary search to find the smallest valid capacity."
    }
  ],
  "sources": [
    {
      "id": "original-practice-set",
      "title": "Ten Problems authoring record",
