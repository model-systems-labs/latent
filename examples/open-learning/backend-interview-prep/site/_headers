/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'

/learning-feed.json
  Access-Control-Allow-Origin: *
  Cache-Control: no-cache

/learning-pack.json
  Access-Control-Allow-Origin: *
  Cache-Control: no-cache
