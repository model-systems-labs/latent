{
  "name": "@latent/web",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "npm run packages:build",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "npm run packages:build && npm run build:web",
    "build:web": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build && node scripts/prune-browser-only-ssr-assets.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run packages:test && npm run build:web && npm run test:app",
    "test:app": "node --test tests/*.test.mjs",
    "packages:build": "npm run build --workspaces --if-present",
    "packages:test": "npm run test --workspaces --if-present",
    "packages:typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck": "npm run packages:build && tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "boundaries": "node scripts/check-package-boundaries.mjs",
    "validate": "npm run boundaries && npm run typecheck && npm run lint && npm test",
    "artifacts:record-training": "node scripts/generate-recorded-training.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@latent/artifact-runtime": "*",
    "@latent/browser-lab": "*",
    "@latent/course-kit": "*",
    "@latent/mock-services": "*",
    "@latent/tensor": "*",
    "@codemirror/lang-javascript": "6.2.5",
    "@huggingface/transformers": "^3.8.1",
    "codemirror": "6.0.2",
    "dexie": "4.4.4",
    "drizzle-orm": "0.45.2",
    "esbuild-wasm": "0.28.1",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "@vitest/browser-playwright": "4.1.10",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "fake-indexeddb": "6.2.5",
    "playwright": "1.61.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "4.1.10",
    "vitest-browser-react": "2.2.0",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
