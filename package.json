{
  "name": "@latent/web",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "npm run packages:build && npm run runtime:generate",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "npm run packages:build && npm run build:web",
    "build:web": "npm run runtime:generate && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build && node scripts/prune-browser-only-ssr-assets.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run packages:test && npm run build:web && npm run test:performance && npm run test:app",
    "test:app": "node --test tests/*.test.mjs",
    "test:pytorch-native": "node scripts/verify-pytorch-handoffs.mjs",
    "test:performance": "node scripts/check-performance-budget.mjs",
    "packages:build": "npm run build --workspaces --if-present",
    "packages:test": "npm run test --workspaces --if-present",
    "packages:typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck": "npm run packages:build && tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "boundaries": "node scripts/check-package-boundaries.mjs",
    "validate": "npm run boundaries && npm run typecheck && npm run lint && npm test",
    "runtime:generate": "node scripts/generate-capstone-react-runtime.mjs",
    "artifacts:record-training": "npm run build --workspace @latent/model-lab && npm run build --workspace @latent/training-replay && node scripts/generate-recorded-training.mjs"
  },
  "dependencies": {
    "@latent/artifact-runtime": "*",
    "@latent/browser-lab": "*",
    "@latent/course-kit": "*",
    "@latent/model-lab": "*",
    "@latent/mock-services": "*",
    "@latent/python-lab": "*",
    "@latent/tensor": "*",
    "@latent/training-replay": "*",
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.6",
    "@huggingface/transformers": "^3.8.1",
    "@lezer/highlight": "1.2.3",
    "@lezer/javascript": "1.5.4",
    "codemirror": "6.0.2",
    "dexie": "4.4.4",
    "esbuild-wasm": "0.28.1",
    "fflate": "0.7.4",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.44.0",
    "@cloudflare/workers-types": "5.20260713.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "@vitest/browser-playwright": "4.1.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "fake-indexeddb": "6.2.5",
    "playwright": "1.61.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.4",
    "vitest": "4.1.10",
    "vitest-browser-react": "2.2.0",
    "wrangler": "4.110.0"
  },
  "overrides": {
    "postcss": "8.5.19"
  },
  "type": "module"
}
