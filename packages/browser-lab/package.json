{
  "name": "@latent/browser-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Course-agnostic virtual-project compiler, QuickJS sandbox, contracts, receipts, and build promotion boundary.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./compiler": {
      "types": "./src/compiler/index.ts",
      "import": "./src/compiler/index.ts",
      "default": "./src/compiler/index.ts"
    },
    "./contracts": {
      "types": "./src/contracts.ts",
      "import": "./src/contracts.ts",
      "default": "./src/contracts.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "import": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./worker": {
      "types": "./src/worker/index.ts",
      "import": "./src/worker/index.ts",
      "default": "./src/worker/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "validate": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "esbuild-wasm": "0.28.1",
    "quickjs-emscripten-core": "0.32.0"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "sideEffects": [
    "./src/compiler/compiler.worker.ts",
    "./src/worker/sandbox.worker.ts"
  ]
}
