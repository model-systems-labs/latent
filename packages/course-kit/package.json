{
  "name": "@latent/course-kit",
  "version": "0.2.0",
  "description": "Model-neutral schemas, validation, and static publishing for portable lessons, flash cards, and question groups.",
  "license": "Apache-2.0",
  "author": "Model Systems Labs",
  "homepage": "https://github.com/model-systems-labs/latent/tree/main/packages/course-kit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/model-systems-labs/latent.git",
    "directory": "packages/course-kit"
  },
  "bugs": {
    "url": "https://github.com/model-systems-labs/latent/issues"
  },
  "keywords": [
    "education",
    "flashcards",
    "learning",
    "lessons",
    "llm",
    "programming-practice",
    "question-groups",
    "static-site"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "bin",
    "dist",
    "docs",
    "schema",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "latent-learning": "bin/latent-learning.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./curriculum": {
      "types": "./dist/curriculum.d.ts",
      "import": "./dist/curriculum.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./learning-pack": {
      "types": "./dist/learning-pack.d.ts",
      "import": "./dist/learning-pack.js"
    },
    "./learner-ui": {
      "types": "./dist/learner-ui.d.ts",
      "import": "./dist/learner-ui.js"
    },
    "./question-group": {
      "types": "./dist/question-group.d.ts",
      "import": "./dist/question-group.js"
    },
    "./question-group-player": {
      "types": "./dist/question-player.d.ts",
      "import": "./dist/question-player.js"
    },
    "./question-group-progress": {
      "types": "./dist/question-progress.d.ts",
      "import": "./dist/question-progress.js"
    },
    "./question-group-site": {
      "types": "./dist/question-group-site.d.ts",
      "import": "./dist/question-group-site.js"
    },
    "./static-site": {
      "types": "./dist/static-site.d.ts",
      "import": "./dist/static-site.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "prepare:package": "node scripts/prepare-package.mjs",
    "prepack": "npm run clean && npm run build && npm run prepare:package && npm run test:built",
    "release:check": "node scripts/check-release.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "test:built": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && npm run test:built",
    "validate": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "esbuild-wasm": "0.28.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "^8.1.4"
  }
}
