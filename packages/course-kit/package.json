{
  "name": "@latent/course-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "bin": {
    "latent-learning": "./bin/latent-learning.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./curriculum": {
      "types": "./dist/curriculum.d.ts",
      "import": "./dist/curriculum.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./learning-pack": {
      "types": "./dist/learning-pack.d.ts",
      "import": "./dist/learning-pack.js"
    },
    "./static-site": {
      "types": "./dist/static-site.d.ts",
      "import": "./dist/static-site.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "validate": "npm run typecheck && npm test"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "^8.1.4"
  }
}
