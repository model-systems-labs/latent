{
  "name": "@latent/python-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Dedicated-worker Pyodide runtime with bounded project I/O.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./protocol": {
      "types": "./src/protocol.ts",
      "import": "./src/protocol.ts",
      "default": "./src/protocol.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "import": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "validate": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "pyodide": "314.0.3"
  },
  "devDependencies": {
    "esbuild": "0.25.11",
    "typescript": "5.9.3"
  },
  "sideEffects": [
    "./src/worker/python.worker.ts"
  ]
}
