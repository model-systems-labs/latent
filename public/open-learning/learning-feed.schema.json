{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "latent-learning-feed"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "publisher": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "url": {
          "type": "string",
          "maxLength": 2000,
          "format": "uri"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "packages": {
      "minItems": 1,
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "packageId": {
            "type": "string",
            "minLength": 3,
            "maxLength": 129,
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}\\/[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
          },
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 160
          },
          "description": {
            "type": "string",
            "minLength": 30,
            "maxLength": 500
          },
          "packageUrl": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "^(?:\\.\\/)?(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))(?!.*\\\\)(?!.*%2e)(?!.*%5c)[A-Za-z0-9._~!$&'()*+,;=:@/-]+(?:#[A-Za-z0-9._~!$&'()*+,;=:@/?-]*)?$"
          },
          "siteUrl": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "^(?:\\.\\/)?(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))(?!.*\\\\)(?!.*%2e)(?!.*%5c)[A-Za-z0-9._~!$&'()*+,;=:@/-]+(?:#[A-Za-z0-9._~!$&'()*+,;=:@/?-]*)?$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 2000000
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "packageId",
          "version",
          "title",
          "description",
          "packageUrl",
          "siteUrl",
          "sha256",
          "bytes",
          "publishedAt"
        ],
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "publisher",
    "packages"
  ],
  "additionalProperties": false,
  "$id": "https://latent-llm-learning.cswansondeveloper.chatgpt.site/open-learning/learning-feed.schema.json",
  "title": "Latent Learning Feed v1",
  "description": "A publisher-controlled list of immutable Latent learning-pack versions with same-origin paths and SHA-256 integrity."
}
